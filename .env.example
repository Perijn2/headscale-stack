# =============================================================================
# .env.example — copy to `.env` on the Pi and edit. NEVER commit the real .env.
# =============================================================================
# Every value the compose modules interpolate lives here, so "what does this
# stack actually configure?" is answerable from one file.
#
#   cp .env.example .env && $EDITOR .env
#
# Values marked (?...) in the modules are REQUIRED — compose refuses to start
# without them. That is intentional: no silent defaults for identity settings.
# -----------------------------------------------------------------------------

# --- Identity ----------------------------------------------------------------
# Public hostname your tailnet connects to. Must resolve to this Pi's public
# address (static IP, DDNS, or tunnel). Caddy obtains the TLS cert for this
# exact name; headscale advertises it to every client.
DOMAIN=head.example.com

# Let's Encrypt expiry notifications go here.
TLS_EMAIL=admin@example.com

# --- Pinned versions ----------------------------------------------------------
# Bump deliberately (one line, reviewed); roll back by reverting one line.
# Never use :latest on a device you administer over the network you control.
HEADSCALE_VERSION=0.26.1
HEADPLANE_VERSION=0.8.0
CADDY_VERSION=2.8-alpine
ALPINE_VERSION=3.20

# --- Ports --------------------------------------------------------------------
# DERP relay (UDP). Change only if 3478 is already taken on the LAN.
DERP_PORT=3478

# --- Backup profile (compose/backup.yaml) --------------------------------------
# Snapshot interval in seconds. Default: 86400 = daily.
BACKUP_INTERVAL_SECONDS=86400

# --- Legacy Compose fallback (pre-v2.20, no `include:`) ------------------------
# Uncomment instead of using the root compose.yaml:
# COMPOSE_FILE=compose/headscale.yaml:compose/headplane.yaml:compose/caddy.yaml
